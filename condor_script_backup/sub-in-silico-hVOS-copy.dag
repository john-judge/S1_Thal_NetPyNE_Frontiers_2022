############################
#run15_56
############################

JOB run15_56_S1 subdag-job.sub
VARS run15_56_S1 run_name="run15_56"

JOB run15_56_extract job-extract.sub
VARS run15_56_extract run_name="run15_56"

JOB run15_56_optical job-analyze-hVOS.sub
VARS run15_56_optical run_name="run15_56"

JOB run15_56_package package.sub
VARS run15_56_package run_name="run15_56"


PARENT run15_56_S1 CHILD run15_56_extract
PARENT run15_56_extract CHILD run15_56_optical
PARENT run15_56_optical CHILD run15_56_package


